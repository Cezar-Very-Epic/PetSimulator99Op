local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local DEFAULT_OPTIONS = {
    AimbotKey = Enum.UserInputType.MouseButton2,
    FovRadius = 120,
    MaxDistance = 150,
    TargetMode = "Mouse", -- "Mouse" or "Player"
    FovColor = Color3.fromRGB(0, 255, 255),
    WallCheck = true,
    CircleVisible = true,
    Smoothing = 0.2,
    TeamCheck = false,
    TargetBodyPart = "HumanoidRootPart",
    CustomCharacterMode = "Default",
	--[[
        - "Default": the game does not use custom characters or anything similar (most games)

        - "Character Folder Specified": the game uses custom characters and puts them all in a folder, the name matches the player names
                                        You specify the folder for the characters when creating the aimbot 

                                        e.g. Aimbot.new({CustomCharacterMode = "Character Folder Specified",
                                                        CharacterFolder = Workspace:WaitForChild("Characters")})

        - "Character Folder Specified and Different Characters with info" = the game uses custom characters and puts them all in a folder, the name matches the player names but
                                                                            the characters are fully different so the default "head, torso, left arm..." stuff won't work because they don't have those
                                                                            You specify the folder for the characters and the name of the body part when creating the aimbot

                                                                            e.g. Aimbot.new({CustomCharacterMode = "Character Folder Specified and Different Characters with info",
                                                                                             CharacterFolder = Workspace:WaitForChild("Characters"),
                                                                                             TargetBodyPart = "WeirdTriangleHead"}) -- will focus on the part named like this


        - "Character Folder Specified and Different Characters no info" = the game uses very weird and random characters. 
                                                                          You specify the folder of the characters and the script tries to guess what to aim at, random parts, starting with the humanoid root part

                                                                          e.g. Aimbot.new({CustomCharacterMode = "Character Folder Specified and Different Characters no info",
                                                                                             CharacterFolder = Workspace:WaitForChild("Characters")"})

        - "Aim folder no characters with info" = you want the aimbot to not even be for players, but for parts or anything put in the folder like vehicles or smth for an aim trainer.
                                       The aimbot will aim at the named part that it finds from each folder. like if there are 3 models and you name the part "base" it will aim at the base of the models
                                       If the folder you picked has only one part (like aim trainers, you pick the folder with the aim parts, but each part is just one circle or smth) pick the no info version.
                                       
                                       e.g. Aimbot.new({CustomCharacterMode = "Aim folder no characters with info",
                                                        CharacterFolder = Workspace:WaitForChild("Vehicles"),
                                                        TargetBodyPart = "Base"})

        - "Aim folder no characters no info" = you want the aimbot to not even be for players, but for parts or anything put in the folder like vehicles or smth for an aim trainer.
                                               the script will automatically try to find parts to aim on from what it finds in the folder or directly to the parts it finds.
                                       
                                       e.g. Aimbot.new({CustomCharacterMode = "Aim folder no characters no info",
                                                        CharacterFolder = Workspace:WaitForChild("Vehicles")})

        - "Automatic" = the script will try to find a character folder and parts to hit on it's own. May cause bugs, not recommended, but can save a lot of speed.
                         e.g. Aimbot.new({CustomCharacterMode = "Automatic"})
    
    ]]
    CharacterFolder = nil,
    TeamMode = "Default", -- Only for teamcheck
	--[[
        - "Default": the game just uses the default roblox teams (most games)

        - "Custom Team": the game uses a way to get custom teams. Like instead of Player.Team it uses Player.Values.TeamValue.Value or smth. Like you will get a player and you need to make the function
                         that will find out what the team is and return it. It can return the team color, the team name, some team id, etc.

                         e.g. 
                            Aimbot = loadstring................
                            local function GetTeam(plr)
                                return plr.Values.TeamValue.Value
                            end
                            Aimbot.new({TeamMode = "CustomTeam",
                                        GetTeamFunction = GetTeam})
    ]]
    GetTeamFunction = nil,
    SingleObject = false,
    SingleObjectToLookAt = nil -- Accepts a BasePart or a Model
}

local AUTOMATIC_FOLDER_PATHS = {
    {"Characters"},
    {"characters"},
    {"Alive", "Characters"},
    {"alive", "characters"},
    {"Alive", "Characters"},
    {"alive", "Characters"},
    {"Players"},
    {"PlayerCharacters"}
}

local Aimbot = {}
Aimbot.__index = Aimbot

-- Creates a new Aimbot instance with merged default and custom options
function Aimbot.new(customOptions)
    local self = setmetatable({}, Aimbot)

    self.Options = {}
    for key, defaultValue in DEFAULT_OPTIONS do
        self.Options[key] = defaultValue
    end

    if customOptions and type(customOptions) == "table" then
        for key, customValue in customOptions do
            self.Options[key] = customValue
        end
    end

    self.IsActive = false
    self.IsHoldingClick = false
    self.Connections = {}
    self.ScreenGui = nil
    self.FovFrame = nil
    self.UiStroke = nil

    return self
end

function Aimbot:_IsSameTeam(targetPlayer)
    if not self.Options.TeamCheck or not targetPlayer then 
        return false 
    end
    
    if self.Options.TeamMode == "Custom Team" and self.Options.GetTeamFunction then
        return self.Options.GetTeamFunction(LocalPlayer) == self.Options.GetTeamFunction(targetPlayer)
    end
    
    return LocalPlayer.Team == targetPlayer.Team
end

function Aimbot:_GetAutomaticFolder()
    local bestFolder = nil
    local firstFoundFolder = nil

    for index, pathArray in AUTOMATIC_FOLDER_PATHS do
        local current = workspace
        local isValid = true

        for innerIndex, pathName in pathArray do
            current = current:FindFirstChild(pathName)
            if not current then
                isValid = false
                break
            end
        end

        if isValid and current then
            if not firstFoundFolder then
                firstFoundFolder = current
            end

            local matchCount = 0
            for playerIndex, player in Players:GetPlayers() do
                if current:FindFirstChild(player.Name) then
                    matchCount += 1
                end
            end

            if matchCount >= 2 then
                bestFolder = current
                break
            end
        end
    end

    return bestFolder or firstFoundFolder
end

function Aimbot:_GetRandomPart(instance)
    if instance:IsA("BasePart") then
        return instance
    end
    
    -- Prioritize root center part before falling back to random limb selections
    local root = instance:FindFirstChild(self.Options.TargetBodyPart) or instance:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then 
        return root 
    end

    local baseParts = {}
    for index, desc in instance:GetDescendants() do
        if desc:IsA("BasePart") then
            table.insert(baseParts, desc)
        end
    end
    
    if #baseParts > 0 then
        return baseParts[math.random(1, #baseParts)]
    end
    
    return nil
end

-- Collects valid target coordinates based on active targeting mode
function Aimbot:_GetTargets()
    local validTargets = {}

    if self.Options.SingleObject and self.Options.SingleObjectToLookAt then
        local obj = self.Options.SingleObjectToLookAt
        if obj:IsA("PVInstance") then
            table.insert(validTargets, {
                Position = obj:GetPivot().Position,
                Player = nil,
                Model = obj
            })
        end
        return validTargets
    end

    local mode = self.Options.CustomCharacterMode
    local folder = self.Options.CharacterFolder
    local targetPartName = self.Options.TargetBodyPart

    if mode == "Automatic" then
        folder = self:_GetAutomaticFolder()
        mode = folder and "Character Folder Specified" or "Default"
    end

    if mode == "Default" then
        for index, player in Players:GetPlayers() do
            if player ~= LocalPlayer and player.Character then
                local part = player.Character:FindFirstChild(targetPartName)
                if part then
                    table.insert(validTargets, {Position = part.Position, Player = player, Model = player.Character})
                end
            end
        end

    elseif mode == "Character Folder Specified" or mode == "Character Folder Specified and Different Characters with info" then
        if folder then 
            for index, player in Players:GetPlayers() do
                if player ~= LocalPlayer then
                    local char = folder:FindFirstChild(player.Name)
                    if char then
                        local part = char:FindFirstChild(targetPartName)
                        if part then
                            table.insert(validTargets, {Position = part.Position, Player = player, Model = char})
                        end
                    end
                end
            end
        end

    elseif mode == "Character Folder Specified and Different Characters no info" then
        if folder then
            for index, player in Players:GetPlayers() do
                if player ~= LocalPlayer then
                    local char = folder:FindFirstChild(player.Name)
                    if char then
                        local part = self:_GetRandomPart(char)
                        if part then
                            table.insert(validTargets, {Position = part.Position, Player = player, Model = char})
                        end
                    end
                end
            end
        end

    elseif mode == "Aim folder no characters with info" then
        if folder then
            for index, child in folder:GetChildren() do
                local part = child:FindFirstChild(targetPartName)
                if part then
                    table.insert(validTargets, {Position = part.Position, Player = nil, Model = child})
                end
            end
        end

    elseif mode == "Aim folder no characters no info" then
        if folder then
            for index, child in folder:GetChildren() do
                local part = self:_GetRandomPart(child)
                if part then
                    table.insert(validTargets, {Position = part.Position, Player = nil, Model = child})
                end
            end
        end
    end

    return validTargets
end

function Aimbot:_IsPathClear(origin, targetPosition, allTargetModels)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    -- Ignore local character and targets to prevent self-blocking raycast hits
    local ignoreList = {}
    if LocalPlayer.Character then
        table.insert(ignoreList, LocalPlayer.Character)
    end
    
    for index, model in allTargetModels do
        table.insert(ignoreList, model)
    end
    
    raycastParams.FilterDescendantsInstances = ignoreList

    local direction = targetPosition - origin
    local raycastResult = workspace:Raycast(origin, direction, raycastParams)

    return raycastResult == nil
end

function Aimbot:_GetClosestTargetInRadius()
    local closestPosition = nil
    local bestMetric = math.huge

    local myCharacter = LocalPlayer.Character
    if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then
        return nil
    end

    local myRootPos = myCharacter.HumanoidRootPart.Position
    local mousePos = UserInputService:GetMouseLocation()
    
    local potentialTargets = self:_GetTargets()
    
    local allModels = {}
    for index, targetInfo in potentialTargets do
        table.insert(allModels, targetInfo.Model)
    end

    for index, targetInfo in potentialTargets do
        local targetPos = targetInfo.Position
        local player = targetInfo.Player
        
        if self:_IsSameTeam(player) then
            continue
        end

        local distance3D = (targetPos - myRootPos).Magnitude

        if distance3D <= self.Options.MaxDistance then
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)

            if onScreen then
                local screenVector = Vector2.new(screenPos.X, screenPos.Y)
                local distanceFromMouse = (screenVector - mousePos).Magnitude

                if distanceFromMouse <= self.Options.FovRadius then
                    local clearPath = true
                    if self.Options.WallCheck then
                        clearPath = self:_IsPathClear(Camera.CFrame.Position, targetPos, allModels)
                    end

                    if clearPath then
                        local metric = (self.Options.TargetMode == "Mouse") and distanceFromMouse or distance3D

                        if metric < bestMetric then
                            bestMetric = metric
                            closestPosition = targetPos
                        end
                    end
                end
            end
        end
    end

    return closestPosition
end

function Aimbot:_SetupGui()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")

    self.ScreenGui = Instance.new("ScreenGui")
    self.ScreenGui.Name = "AimbotFovGui"
    self.ScreenGui.IgnoreGuiInset = true
    self.ScreenGui.Parent = playerGui

    self.FovFrame = Instance.new("Frame")
    self.FovFrame.Name = "FovFrame"
    self.FovFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    self.FovFrame.BackgroundTransparency = 1
    self.FovFrame.Parent = self.ScreenGui

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(1, 0)
    uiCorner.Parent = self.FovFrame

    self.UiStroke = Instance.new("UIStroke")
    self.UiStroke.Thickness = 2
    self.UiStroke.Parent = self.FovFrame

    local aspectRatio = Instance.new("UIAspectRatioConstraint")
    aspectRatio.AspectRatio = 1
    aspectRatio.Parent = self.FovFrame
end

function Aimbot:_UpdateGui()
    if not self.FovFrame or not self.UiStroke then
        return
    end

    local mousePos = UserInputService:GetMouseLocation()
    local radius = self.Options.FovRadius

    self.FovFrame.Visible = self.Options.CircleVisible
    self.FovFrame.Size = UDim2.new(0, radius * 2, 0, radius * 2)
    self.FovFrame.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)
    self.UiStroke.Color = self.Options.FovColor
end

function Aimbot:Start()
    if self.IsActive then
        return
    end
    self.IsActive = true

    self:_SetupGui()

    local inputBeganConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType == self.Options.AimbotKey then
            self.IsHoldingClick = true
        end
    end)

    local inputEndedConn = UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if input.UserInputType == self.Options.AimbotKey then
            self.IsHoldingClick = false
        end
    end)

    local renderConn = RunService.RenderStepped:Connect(function(deltaTime)
        self:_UpdateGui()

        if self.IsHoldingClick then
            local targetPosition = self:_GetClosestTargetInRadius()

            if targetPosition then
                local currentCFrame = Camera.CFrame
                local targetCFrame = CFrame.new(currentCFrame.Position, targetPosition)
                Camera.CFrame = currentCFrame:Lerp(targetCFrame, self.Options.Smoothing)
            end
        end
    end)

    table.insert(self.Connections, inputBeganConn)
    table.insert(self.Connections, inputEndedConn)
    table.insert(self.Connections, renderConn)
end

function Aimbot:Stop()
    if not self.IsActive then
        return
    end
    self.IsActive = false
    self.IsHoldingClick = false

    for index, connection in self.Connections do
        connection:Disconnect()
    end
    table.clear(self.Connections)

    if self.ScreenGui then
        self.ScreenGui:Destroy()
        self.ScreenGui = nil
        self.FovFrame = nil
        self.UiStroke = nil
    end
end

return Aimbot
